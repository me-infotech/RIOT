# Flags, memory start addresses, linker script and include paths are build
# data: cpu/nrf5x_common/build.yaml. The file included here is generated from
# it (`just generate-config-data`).
include $(RIOTCPU)/nrf5x_common/build.mk

# Fetch all nRF52 vendor headers using the package mechanism. This rule is called all
# the time to ensure it's correctly updated when versions in the packages are
# updated.
fetch_nrfx_vendor_headers: FORCE $(CLEAN)
	$(Q)+$(MAKE) -f $(RIOTBASE)/cpu/nrf5x_common/Makefile.nrfx

BUILDDEPS += fetch_nrfx_vendor_headers
