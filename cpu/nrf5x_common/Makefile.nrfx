# The package variables (name, URL, version, sparse paths, directories) are
# package data: cpu/nrf5x_common/nrfx.pkg.yaml. The file included here is
# generated from it (`just generate-config-data`); it includes pkg/pkg.mk.
include $(RIOTCPU)/nrf5x_common/nrfx.pkg.mk

NRFX_VENDOR_HEADERS := $(addprefix $(VENDOR_FOLDER)/, $(notdir $(PKG_SPARSE_PATHS)))

all: $(NRFX_VENDOR_HEADERS)

$(PKG_PREPARED): $(VENDOR_FOLDER)

# Make sure the folder REALLY exists before trying to copy to it.
$(VENDOR_FOLDER): | $(PKG_PATCHED)
	$(Q)mkdir -p $(VENDOR_FOLDER)

# The package has to be done with the patching before we try to copy the headers.
$(VENDOR_FOLDER)/%: $(PKG_PATCHED) | $(VENDOR_FOLDER)
	@cp $(PKG_SOURCE_DIR)/mdk/$* $@
