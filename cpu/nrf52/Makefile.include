# Programmer and flasher settings: generated from flash.yaml (step G3-2)
include $(RIOTCPU)/nrf52/flash.inc.mk

# Slot size is determined by "((total_flash_size - RIOTBOOT_LEN) / 2)".
# If RIOTBOOT_LEN uses an uneven number of flashpages, the remainder of the
# flash cannot be divided by two slots while staying FLASHPAGE_SIZE aligned.
ifneq (,$(filter usbus_dfu tinyusb_dfu,$(USEMODULE)))
  RIOTBOOT_LEN ?= 0x4000
else
  RIOTBOOT_LEN ?= 0x2000
endif

VECTORS_O ?= $(BINDIR)/nrf52_vectors/vectors_$(CPU_MODEL).o

SVD_VENDOR := Nordic
SVD_MODEL := $(patsubst %xxaa,%,$(CPU_MODEL))

# The MCUboot values exported to the modules, the memory sizes and the
# includes are build data: cpu/nrf52/build.yaml. The file included here is
# generated from it (`just generate-config-data`).
include $(RIOTCPU)/nrf52/build.mk
