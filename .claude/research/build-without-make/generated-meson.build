project('hello-world', 'c', meson_version: '>=1.3')

objs0 = static_library('objs0',
  '/riot/examples/basic/hello-world/main.c',
  '/riot/sys/auto_init/auto_init.c',
  '/riot/boards/nrf52840dk/mtd.c',
  '/riot/boards/common/init/board_common.c',
  '/riot/core/cond.c',
  '/riot/core/msg.c',
  '/riot/core/mutex.c',
  '/riot/core/sched.c',
  '/riot/core/thread.c',
  '/riot/core/lib/assert.c',
  '/riot/core/lib/atomic_c11.c',
  '/riot/core/lib/atomic_sync.c',
  '/riot/core/lib/bitarithm.c',
  '/riot/core/lib/clist.c',
  '/riot/core/lib/init.c',
  '/riot/core/lib/panic.c',
  '/riot/core/lib/priority_queue.c',
  '/riot/core/lib/ringbuffer.c',
  '/riot/core/lib/rmutex.c',
  '/riot/cpu/cortexm_common/cortexm_init.c',
  '/riot/cpu/cortexm_common/mpu.c',
  '/riot/cpu/cortexm_common/panic.c',
  '/riot/cpu/cortexm_common/thread_arch.c',
  '/riot/cpu/cortexm_common/vectors_cortexm.c',
  '/riot/cpu/cortexm_common/periph/pm.c',
  '/riot/cpu/nrf52/cpu.c',
  '/riot/cpu/nrf52/spi_twi_irq.c',
  '/riot/cpu/nrf5x_common/clock.c',
  '/riot/sys/div/div.c',
  '/riot/sys/libc/string.c',
  '/riot/sys/malloc_thread_safe/malloc_wrappers.c',
  '/riot/sys/newlib_syscalls_default/syscalls.c',
  '/riot/cpu/nrf52/vectors/vectors_nrf52840xxaa.c',
  '/riot/cpu/nrf5x_common/periph/gpio.c',
  '/riot/cpu/nrf5x_common/periph/pm.c',
  '/riot/cpu/nrf5x_common/periph/uart.c',
  '/riot/drivers/periph_common/gpio.c',
  '/riot/drivers/periph_common/init.c',
  '/riot/drivers/periph_common/init_buttons.c',
  '/riot/drivers/periph_common/init_leds.c',
  '/riot/drivers/periph_common/pm.c',
  '/riot/sys/stdio/stdio.c',
  '/riot/sys/stdio_uart/stdio_uart.c',
  c_args: ['-DDEVELHELP', '-Werror', '-DCPU_FAM_NRF52', '-mno-thumb-interwork', '-mcpu=cortex-m4', '-mlittle-endian', '-mthumb', '-mfloat-abi=hard', '-mfpu=fpv4-sp-d16', '-ffunction-sections', '-fdata-sections', '-fshort-enums', '-ggdb', '-g3', '-Os', '-DCPU_MODEL_NRF52840XXAA', '-DCPU_CORE_CORTEX_M4F', '-DRIOT_APPLICATION="hello-world"', '-DBOARD_NRF52840DK="nrf52840dk"', '-DRIOT_BOARD=BOARD_NRF52840DK', '-DCPU_NRF52="nrf52"', '-DRIOT_CPU=CPU_NRF52', '-std=c11', '-fwrapv', '-Wstrict-overflow', '-fno-common', '-ffunction-sections', '-fdata-sections', '-Wall', '-Wextra', '-Wmissing-include-dirs', '-fno-delete-null-pointer-checks', '-fdiagnostics-color', '-Wstrict-prototypes', '-Wold-style-definition', '-gz', '-Wformat=2', '-Wformat-overflow', '-Wformat-truncation', '-fmacro-prefix-map=/riot/=', '-fdebug-prefix-map=/riot/=', '-Wcast-align', '-DCPU_RAM_BASE=0x20000000', '-DCPU_RAM_SIZE=0x40000', '-D__int64_t_defined=1', '-include', '/riot/examples/basic/hello-world/bin/nrf52840dk/riotbuild/riotbuild.h', '-isystem', '/opt/gcc-arm-none-eabi-10.3-2021.10/arm-none-eabi/include/newlib-nano', '-I/riot/examples/basic/hello-world', '-I/riot/core/lib/include', '-I/riot/core/include', '-I/riot/drivers/include', '-I/riot/sys/include', '-I/riot/boards/nrf52840dk/include', '-I/riot/cpu/nrf52/include', '-I/riot/boards/common/nrf52xxxdk/include', '-I/riot/boards/common/nrf52/include', '-I/riot/cpu/nrf5x_common/include', '-I/riot/build/nrf5x_nrfx_mdk/nrf52', '-I/riot/cpu/cortexm_common/include', '-I/riot/sys/libc/include', '-isystem/riot/build/pkg/cmsis/CMSIS/Core/Include', '-I/riot/sys/auto_init/include', '-I/riot/examples/basic/hello-world/bin/nrf52840dk/preprocessor'],
  build_by_default: false)
objs1 = static_library('objs1',
  '/riot/build/pkg/mpaland-printf/printf.c',
  c_args: ['-DDEVELHELP', '-Werror', '-DCPU_FAM_NRF52', '-mno-thumb-interwork', '-mcpu=cortex-m4', '-mlittle-endian', '-mthumb', '-mfloat-abi=hard', '-mfpu=fpv4-sp-d16', '-ffunction-sections', '-fdata-sections', '-fshort-enums', '-ggdb', '-g3', '-Os', '-DCPU_MODEL_NRF52840XXAA', '-DCPU_CORE_CORTEX_M4F', '-DRIOT_APPLICATION="hello-world"', '-DBOARD_NRF52840DK="nrf52840dk"', '-DRIOT_BOARD=BOARD_NRF52840DK', '-DCPU_NRF52="nrf52"', '-DRIOT_CPU=CPU_NRF52', '-std=c11', '-fwrapv', '-Wstrict-overflow', '-fno-common', '-ffunction-sections', '-fdata-sections', '-Wall', '-Wextra', '-Wmissing-include-dirs', '-fno-delete-null-pointer-checks', '-fdiagnostics-color', '-Wstrict-prototypes', '-Wold-style-definition', '-gz', '-Wformat=2', '-Wformat-overflow', '-Wformat-truncation', '-fmacro-prefix-map=/riot/=', '-fdebug-prefix-map=/riot/=', '-Wcast-align', '-DCPU_RAM_BASE=0x20000000', '-DCPU_RAM_SIZE=0x40000', '-D__int64_t_defined=1', '-include', '/riot/examples/basic/hello-world/bin/nrf52840dk/riotbuild/riotbuild.h', '-Wno-maybe-uninitialized', '-isystem', '/opt/gcc-arm-none-eabi-10.3-2021.10/arm-none-eabi/include/newlib-nano', '-I/riot/examples/basic/hello-world', '-I/riot/core/lib/include', '-I/riot/core/include', '-I/riot/drivers/include', '-I/riot/sys/include', '-I/riot/boards/nrf52840dk/include', '-I/riot/cpu/nrf52/include', '-I/riot/boards/common/nrf52xxxdk/include', '-I/riot/boards/common/nrf52/include', '-I/riot/cpu/nrf5x_common/include', '-I/riot/build/nrf5x_nrfx_mdk/nrf52', '-I/riot/cpu/cortexm_common/include', '-I/riot/sys/libc/include', '-isystem/riot/build/pkg/cmsis/CMSIS/Core/Include', '-I/riot/sys/auto_init/include', '-I/riot/examples/basic/hello-world/bin/nrf52840dk/preprocessor'],
  build_by_default: false)

elf = executable('hello-world.elf',
  objects: [
    objs0.extract_objects('/riot/examples/basic/hello-world/main.c'),
    objs0.extract_objects('/riot/sys/auto_init/auto_init.c'),
    objs0.extract_objects('/riot/boards/nrf52840dk/mtd.c'),
    objs0.extract_objects('/riot/boards/common/init/board_common.c'),
    objs0.extract_objects('/riot/core/cond.c'),
    objs0.extract_objects('/riot/core/msg.c'),
    objs0.extract_objects('/riot/core/mutex.c'),
    objs0.extract_objects('/riot/core/sched.c'),
    objs0.extract_objects('/riot/core/thread.c'),
    objs0.extract_objects('/riot/core/lib/assert.c'),
    objs0.extract_objects('/riot/core/lib/atomic_c11.c'),
    objs0.extract_objects('/riot/core/lib/atomic_sync.c'),
    objs0.extract_objects('/riot/core/lib/bitarithm.c'),
    objs0.extract_objects('/riot/core/lib/clist.c'),
    objs0.extract_objects('/riot/core/lib/init.c'),
    objs0.extract_objects('/riot/core/lib/panic.c'),
    objs0.extract_objects('/riot/core/lib/priority_queue.c'),
    objs0.extract_objects('/riot/core/lib/ringbuffer.c'),
    objs0.extract_objects('/riot/core/lib/rmutex.c'),
    objs0.extract_objects('/riot/cpu/cortexm_common/cortexm_init.c'),
    objs0.extract_objects('/riot/cpu/cortexm_common/mpu.c'),
    objs0.extract_objects('/riot/cpu/cortexm_common/panic.c'),
    objs0.extract_objects('/riot/cpu/cortexm_common/thread_arch.c'),
    objs0.extract_objects('/riot/cpu/cortexm_common/vectors_cortexm.c'),
    objs0.extract_objects('/riot/cpu/cortexm_common/periph/pm.c'),
    objs0.extract_objects('/riot/cpu/nrf52/cpu.c'),
    objs0.extract_objects('/riot/cpu/nrf52/spi_twi_irq.c'),
    objs0.extract_objects('/riot/cpu/nrf5x_common/clock.c'),
    objs0.extract_objects('/riot/sys/div/div.c'),
    objs0.extract_objects('/riot/sys/libc/string.c'),
    objs0.extract_objects('/riot/sys/malloc_thread_safe/malloc_wrappers.c'),
    objs1.extract_objects('/riot/build/pkg/mpaland-printf/printf.c'),
    objs0.extract_objects('/riot/sys/newlib_syscalls_default/syscalls.c'),
    objs0.extract_objects('/riot/cpu/nrf52/vectors/vectors_nrf52840xxaa.c'),
    objs0.extract_objects('/riot/cpu/nrf5x_common/periph/gpio.c'),
    objs0.extract_objects('/riot/cpu/nrf5x_common/periph/pm.c'),
    objs0.extract_objects('/riot/cpu/nrf5x_common/periph/uart.c'),
    objs0.extract_objects('/riot/drivers/periph_common/gpio.c'),
    objs0.extract_objects('/riot/drivers/periph_common/init.c'),
    objs0.extract_objects('/riot/drivers/periph_common/init_buttons.c'),
    objs0.extract_objects('/riot/drivers/periph_common/init_leds.c'),
    objs0.extract_objects('/riot/drivers/periph_common/pm.c'),
    objs0.extract_objects('/riot/sys/stdio/stdio.c'),
    objs0.extract_objects('/riot/sys/stdio_uart/stdio_uart.c'),
  ],
  link_args: ['-lm', '-L/riot/cpu/nrf52/ldscripts', '-L/riot/cpu/cortexm_common/ldscripts', '-Tcortexm.ld', '-Wl,--fatal-warnings', '-mcpu=cortex-m4', '-mlittle-endian', '-mthumb', '-mfloat-abi=hard', '-mfpu=fpv4-sp-d16', '-ggdb', '-g3', '-Os', '-static', '-lgcc', '-nostartfiles', '-Wl,--gc-sections', '-Wl,--defsym=_rom_start_addr=0x00000000', '-Wl,--defsym=_ram_start_addr=0x20000000', '-Wl,--defsym=_rom_length=0x100000', '-Wl,--defsym=_ram_length=0x40000', '-L/riot/core/ldscripts', '-z', 'noexecstack', '-Wl,-wrap=malloc', '-Wl,-wrap=calloc', '-Wl,-wrap=realloc', '-Wl,-wrap=free', '-specs=nano.specs', '-lc', '-Wl,-wrap=__assert_func', '-Wl,--defsym=_slot_aux_offset=1048576', '-Wl,--defsym=_slot_aux_len=0', '-Wl,-wrap=printf', '-Wl,-wrap=fprintf', '-Wl,-wrap=dprintf', '-Wl,-wrap=sprintf', '-Wl,-wrap=snprintf', '-Wl,-wrap=vprintf', '-Wl,-wrap=vfprintf', '-Wl,-wrap=vdprintf', '-Wl,-wrap=vsprintf', '-Wl,-wrap=vsnprintf', '-Wl,-wrap=putchar', '-Wl,-wrap=putc', '-Wl,-wrap=fputc', '-Wl,-wrap=puts', '-Wl,-wrap=fputs', '-Wl,-wrap=_printf_common', '-Wl,-wrap=_fprintf_r', '-Wl,-wrap=_printf_r', '-Wl,-wrap=iprintf', '-Wl,-wrap=fiprintf', '-Wl,-Map=/riot/examples/basic/hello-world/bin/nrf52840dk/hello-world.map'])

# group 2A: resolved state, printed without building
run_target('info-modules', command: ['cat', meson.current_source_dir() / 'modules.txt'])
run_target('info-cpu', command: ['echo', 'nrf52'])

# group 2B: existing ELF / programmer / terminal, no build
run_target('info-buildsize', command: ['arm-none-eabi-size', '-d', '-B', meson.current_build_dir() / 'hello-world.elf'])
run_target('flash-only', command: ['/riot/dist/tools/openocd/openocd.sh', 'flash', meson.current_build_dir() / 'hello-world.elf'])
run_target('term', command: ['/riot/dist/tools/pyterm/pyterm', '-p', '/dev/ttyACM0', '-b', '115200', '-ln', '/tmp/pyterm-', '-rn', '2026-11-14_21.30.15-hello-world-nrf52840dk'])

# group 3: build, then flash
run_target('flash', command: ['/riot/dist/tools/openocd/openocd.sh', 'flash', elf])
