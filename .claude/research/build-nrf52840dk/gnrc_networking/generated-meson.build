# group 2A: resolved state, printed without building
run_target('info-modules', command: ['cat', meson.current_source_dir() / 'modules.txt'])
run_target('info-cpu', command: ['echo', 'nrf52'])

# group 2B: existing ELF / programmer / terminal, no build
run_target('info-buildsize', command: ['arm-none-eabi-size', '-d', '-B', meson.current_build_dir() / 'gnrc_networking.elf'])
run_target('flash-only', command: ['/riot/dist/tools/openocd/openocd.sh', 'flash', meson.current_build_dir() / 'gnrc_networking.elf'])
run_target('term', command: ['/riot/dist/tools/pyterm/pyterm', '-p', '/dev/ttyACM0', '-b', '115200', '-ln', '/tmp/pyterm-', '-rn', '2026-11-14_16.33.09-gnrc_networking-nrf52840dk'])

# group 3: build, then flash
run_target('flash', command: ['/riot/dist/tools/openocd/openocd.sh', 'flash', elf])
