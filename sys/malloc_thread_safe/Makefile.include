# use the wrapper functions for malloc and friends to provide thread-safety
LINKFLAGS += -Wl,-wrap=malloc
LINKFLAGS += -Wl,-wrap=calloc
LINKFLAGS += -Wl,-wrap=realloc
LINKFLAGS += -Wl,-wrap=free
